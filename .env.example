# Django Settings
SECRET_KEY=django-insecure-stripe-gateway-super-secret-key-change-in-production-12345
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# PostgreSQL Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=payment_gateway_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379/0
REDIS_CACHE_URL=redis://redis:6379/1

# Celery & RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email Settings (Console backend for dev)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=noreply@stripe-gateway.com
EMAIL_HOST_PASSWORD=dummy_password

# JWT Settings
JWT_ACCESS_EXPIRATION_MINUTES=60
JWT_REFRESH_EXPIRATION_DAYS=7

# Mock Payment Gateways Configuration
STRIPE_MOCK_SECRET_KEY=sk_test_mock_stripe_secret_key_12345
RAZORPAY_MOCK_KEY_ID=rzp_test_mock_key_id_12345
RAZORPAY_MOCK_KEY_SECRET=rzp_test_mock_secret_12345
