{
  "info": {
    "_postman_id": "a8f3412b-3489-4e78-bc91-88741dfa9291",
    "name": "Payment Gateway Backend API (v1.0.0)",
    "description": "Production API Collection for Google Antigravity Payment Gateway Backend. Includes Auth, Merchant Management, Customer CRM, Orders, Payments, Refunds, Wallets, Webhooks, Analytics, and Audit Logs.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api/v1",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "merchantPublishableKey",
      "value": "",
      "type": "string"
    },
    {
      "key": "merchantSecretKey",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User / Merchant",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"merchant_postman@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"role\": \"MERCHANT\",\n  \"first_name\": \"Postman\",\n  \"last_name\": \"Demo\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register", ""]
            }
          }
        },
        {
          "name": "Login (Obtain JWT)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo_merchant@gateway.com\",\n  \"password\": \"DemoPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login", ""]
            }
          }
        },
        {
          "name": "Refresh Token",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"YOUR_REFRESH_TOKEN_HERE\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/token/refresh/",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token", "refresh", ""]
            }
          }
        }
      ]
    },
    {
      "name": "Merchant Profile & API Keys",
      "item": [
        {
          "name": "Get Merchant Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/merchant/profile/",
              "host": ["{{baseUrl}}"],
              "path": ["merchant", "profile", ""]
            }
          }
        },
        {
          "name": "Generate API Key Pair",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Integration Key\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/merchant/api-keys/",
              "host": ["{{baseUrl}}"],
              "path": ["merchant", "api-keys", ""]
            }
          }
        }
      ]
    },
